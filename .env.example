# IncuBrix Long-Tail Destination Network: every setting, with safe DEV-ONLY defaults.
# Copy to .env (never committed). Values here are placeholders for local use, not real secrets.

# --- service ---
APP_ENV=dev
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
LOG_LEVEL=INFO
LOG_JSON=true
SEED=42

# --- database (Postgres 16; also the job queue and idempotency store) ---
DATABASE_URL=postgresql+asyncpg://ibx:ibx-dev-password@postgres:5432/ibx
POSTGRES_PASSWORD=ibx-dev-password
DB_AUTO_MIGRATE=true
DB_POOL_SIZE=10

# --- object storage (SeaweedFS S3 gateway) ---
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=ibx-dev-access
S3_SECRET_KEY=ibx-dev-secret
S3_BUCKET=ibx
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY_S=3600

# --- API security ---
# Dev placeholders below: APP_ENV=demo|prod refuses them. scripts/gen_secrets.sh writes fresh values into .env.
API_TOKEN=ibx-dev-token
# Fernet key for credentials at rest; empty = derived from API_TOKEN (dev only).
# Generate one: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# HMAC key for job callbacks (X-IncuBrix-Signature); empty = API_TOKEN
CALLBACK_SECRET=
RATE_LIMIT_PER_MIN=600
# IPs/CIDRs of reverse proxies (Caddy, a tunnel) whose X-Forwarded-For is believed; empty = trust nobody
TRUSTED_PROXIES=
HTTP_IDEMPOTENCY_ENABLED=true

# --- simulation / mocks ---
# true = every connection is rewritten to mock-platforms with sim-* credentials (zero real keys)
SIMULATION_MODE=false
MOCK_PLATFORM_URL=http://mock-platforms:8080
# placeholder signing secret the partner mock accepts in simulation (not a real secret)
SIM_SECRET=sim-secret
BOOTSTRAP_OUT_DIR=/bootstrap/out

# --- connectors and reliability ---
DISABLED_CONNECTORS=
PLATFORM_TIMEOUT_S=10
TEST_POST_TTL_S=300
CIRCUIT_FAILS=5
CIRCUIT_OPEN_S=300
IDEMPOTENCY_TTL_H=24
IDEMPOTENCY_LOCK_WAIT_S=15
IDEMPOTENCY_SETTLE_S=5
RATE_LIMIT_MAX_WAIT_S=2
RATE_LIMIT_DEFAULT_RETRY_S=60
LEMMY_RL_FALLBACK_S=60

# --- jobs ---
WORKER_POLL_S=2
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_STALE_AFTER_S=900
SCHEDULER_ENABLED=true
SCHEDULER_TICK_S=5
CALLBACK_TIMEOUT_S=5
WORKER_HEARTBEAT_FILE=/tmp/ibx-worker-heartbeat

# LLM (free only). auto = gemini -> groq -> openrouter -> ollama -> mock (providers without a key are skipped).
# Measured 2026-10-20 (scripts/eval_rules_capture.py --ipv4 --gemini-model ..., 22 saved rules pages, free tier,
# evidence/metrics/rules_capture_eval_summary.csv): gemini-3.5-flash field accuracy 0.871 vs mock 0.833, false rules 0 vs 1
# (0.99 on the 16 pages it answered; 6 pages got HTTP 503/429 and count as wrong). gemini-3.8-flash mostly timed out
# (>60 s) or hit 429 that day: 0.591. So with a key, LLM_PROVIDER=auto + GEMINI_MODEL=gemini-3.5-flash beats the mock
# (failed calls fall back to it). The default stays mock until a person decides (a person confirms every rule anyway).
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x always thinks; thinking tokens count against max_tokens. reasoning_effort: minimal|low|medium|high (empty = not sent).
GEMINI_REASONING_EFFORT=low
GEMINI_MIN_OUTPUT_TOKENS=4096
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OLLAMA_MODEL=qwen2.5:1.5b-instruct
LLM_TIMEOUT_S=30
OLLAMA_TIMEOUT_S=240
LLM_MAX_BACKOFF_S=5
LLM_COOLDOWN_S=60
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=16384
# true = the adapter's own HTTP client uses IPv4 only (host-side scripts where the IPv6 route to the provider times out)
LLM_HTTP_IPV4=false
OLLAMA_URL=http://ollama:11434/v1
LLM_MODEL=mock-heuristic-v1
LLM_PRICE_PER_1K_TOKENS_USD=0

# --- files in/out (IS7), certification, test-post sweeper ---
# signed download links (/api/v1/files/...) start with this; keep it in step with IBX_API_PORT
PUBLIC_BASE_URL=http://127.0.0.1:8088
FILE_LINK_EXPIRY_S=3600
MEDIA_MAX_BYTES=52428800
MEDIA_ALLOWED_MIME=image/png,image/jpeg,image/gif,image/webp,video/mp4,video/webm,application/pdf
MEDIA_FETCH_TIMEOUT_S=15
# certification test posts only ever go to these hosts (own local instances and mocks)
CERT_OWN_HOSTS=lemmy,ghost,discourse,mock-platforms,toxiproxy,localhost,127.0.0.1
# own containers that server-side URL fetches may reach (simulation or dev/test only); never toxiproxy/postgres/s3
FETCH_LOCAL_HOSTS=mock-platforms,lemmy,ghost,discourse,localhost,127.0.0.1
# (localhost / 127.0.0.1 in FETCH_LOCAL_HOSTS only apply when APP_ENV is dev or test)
CERT_LIVE_TIMEOUT_S=30
SWEEPER_EVERY_S=60
# a rate-limited / circuit-open certification run is rescheduled (level kept), at most this many times in a row
CERT_RESCHEDULE_MAX=3
CERT_RESCHEDULE_MAX_DELAY_S=3600
# evidence screenshots: the shooter service (docker compose --profile evidence); empty = no screenshots
SCREENSHOT_URL=
SCREENSHOT_URL_REWRITES=

# --- metrics, recertification, rules drift, alerts (see docs/METRICS.md) ---
METRICS_POLL_EVERY_S=21600
METRICS_POLL_WINDOW_DAYS=30
METRICS_POLL_MAX=200
# L1+ destinations certified longer ago than this are re-tested (must stay below 30 days)
RECERT_AFTER_DAYS=21
RECERT_TICK_EVERY_S=86400
RECERT_MAX_PER_TICK=100
RECERT_CONCURRENCY=2
RECERT_JITTER_S=600
RECERT_RETRY_EXCLUDED_AFTER_S=86400
RECERT_SELF_HEAL_EVERY_S=60
RECERT_SELF_HEAL_COOLDOWN_S=3600
RULES_DRIFT_ENABLED=true
ALERT_DELIVER_EVERY_S=60
# alert sinks: the log always; an HMAC-signed webhook and a GitHub issue only when set (empty = off)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_API_URL=https://api.github.com

# --- compose host ports (only these two are published) ---
IBX_API_PORT=8088
IBX_MOCK_PORT=8089

# --- local real instances (deploy/compose/*.yaml); credentials are created by the bootstrap at runtime ---
# chown the bootstrap output to the API image's non-root user so the files can be 0600
IBX_BOOTSTRAP_OUT_UID=10001
IBX_BOOTSTRAP_OUT_GID=10001
IBX_TOXIPROXY_URL=http://toxiproxy:8474
IBX_LEMMY_PROXY_URL=http://toxiproxy:18536
IBX_GHOST_PROXY_URL=http://toxiproxy:12368

# --- all-in-one live demo (Dockerfile.demo / render.yaml only; see deploy/render/DEPLOY.md) ---
# create + certify the demo destinations (seed/*.csv) when the demo container starts; existing rows are left as they are
DEMO_SEED_ON_START=true
